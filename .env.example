# ============================================================
# ResiKu Backend — Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
# ============================================================

# Koneksi PostgreSQL (PRD: Free Tier Neon.tech / Supabase).
# Contoh Neon : postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Contoh Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
# Contoh lokal : postgresql://postgres:postgres@localhost:5432/resiku?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/resiku?schema=public"
